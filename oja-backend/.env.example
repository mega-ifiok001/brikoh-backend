# Brikoh backend environment variables — copy to .env and fill in real values.
# Never commit real values. All vars are validated at boot by src/config/env.ts.

NODE_ENV=development
PORT=4000

# Trust the first reverse-proxy hop so IP-keyed rate limits see the real
# client address. 0 = off (default), 1 = trust one proxy hop. Set to 1 in
# production behind a single reverse proxy.
TRUST_PROXY=0

# Local PostgreSQL connection strings (development and test databases).
# No pooler, no shadow database: Prisma auto-creates a temporary shadow
# database during `migrate dev` (the role needs CREATEDB).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/brikoh_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/brikoh_test

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-64-char-random-string

# Secret used to sign refresh JWTs. Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=change-me-to-another-64-char-random

# Token lifetimes, as durations: 30s, 15m, 24h, 7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Purpose-bound email OTP codes. Generate a separate key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OTP_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15
OTP_CLEANUP_INTERVAL_MS=24h

# Secret used to sign platform-staff (admin) JWTs — a SEPARATE secret from
# JWT_SECRET, min 32 chars. Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET=change-me-to-a-64-char-random-string
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (image CDN + signed direct uploads). The client POSTs multipart
# straight to api.cloudinary.com with the signing params this API returns —
# no bytes ever transit the backend. Signing is a pure local computation, so
# any values work for local tests; use real credentials for production.
# Get these from the Cloudinary console (Dashboard > Account details).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Root folder under which every store's uploads live (default: stores).
CLOUDINARY_FOLDER_PREFIX=stores

# Frontend origin, used to build accept-invite links in invite emails.
FRONTEND_URL=https://app.example.com

# Staff invite validity window.
INVITE_EXPIRES_IN=7d

# How often the merchant-alert sweep runs (low stock / expiring soon).
# Duration like 30m, 6h, 1d. Best-effort in-process timer — see
# docs/api-contracts/dashboard-notifications.md.
ALERT_SWEEP_INTERVAL_MS=6h

# Platform Paystack keys — the PLATFORM'S OWN Paystack account, used to bill
# merchants for their Brikoh subscriptions. These are NOT the merchant's
# storefront keys (those live in merchant PaymentCredential rows). The
# subscription webhook (/api/webhooks/paystack-subscriptions) verifies HMAC
# against the secret here. Dummies are fine locally; real keys in prod.
PLATFORM_PAYSTACK_SECRET_KEY=sk_test_platform
PLATFORM_PAYSTACK_PUBLIC_KEY=pk_test_platform

# Grace window a PAST_DUE subscription stays usable after a failed renewal,
# before enforcement kicks in.
SUBSCRIPTION_GRACE_PERIOD_MS=3d

# How often the subscription sweep runs (deferred downgrades, swap retries,
# past-grace enforcement).
SUBSCRIPTION_SWEEP_INTERVAL_MS=1h

# Resend transactional email (invite delivery). Use a real key + verified
# sending domain (SPF/DKIM) in production.
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL_ACCOUNT=welcome@your-domain.com
RESEND_FROM_EMAIL_INVITE=hello@your-domain.com
RESEND_FROM_EMAIL_ALERT=notifications@your-domain.com
# Customer receipt emails — sent with the merchant's store name as the
# display name and the owner's email as reply-to. Must be on a verified
# Resend domain (SPF/DKIM).
RESEND_FROM_EMAIL_RECEIPT=receipts@admin.your-domain.com

# Google OAuth (Sign in with Google). Create a "Web application" client in
# Google Cloud Console. The backend exchanges the authorization code with
# the client secret — never expose the secret to the browser. Authorized
# JavaScript origins and redirect URIs must list every frontend origin
# (production + previews); redirect URIs end in /auth/google/callback.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# 32-byte master key (64 hex chars) for AES-256-GCM encryption of merchant
# payment credentials at rest. Generate with: openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY=your-64-hex-char-key

# Shipbubble API (platform account). Use the sandbox key during integration;
# switch mode only after operational and billing approval. Never expose this
# key to a mobile or web client.
SHIPBUBBLE_MODE=sandbox
SHIPBUBBLE_ENABLE_LIVE=false
# SHIPBUBBLE_API_KEY=sb_sandbox_your-key
# Use a random 32+ character value and configure this URL in Shipbubble:
# https://api.your-domain.com/api/webhooks/shipbubble/<secret>
# SHIPBUBBLE_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Additional CORS-allowed origins (comma-separated). Each entry allows the
# exact origin AND sibling subdomains of its apex (rotating preview hosts).
CORS_EXTRA_ORIGINS=https://preview-1.arena.site
